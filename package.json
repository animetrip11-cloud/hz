{
  "name": "folio-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/copy-pdf-assets.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && bash scripts/build-android.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@playwright/test": "^1.58.0",
    "vite": "^7.3.1"
  }
}
